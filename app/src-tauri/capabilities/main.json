{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The UNTRACE interface: only the main window, only UNTRACE's own commands, and event listening. Web content never runs in a Tauri webview, so it has no capabilities at all.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ui-ready",
    "allow-tab-new",
    "allow-tab-close",
    "allow-tab-activate",
    "allow-tab-cycle",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-stop",
    "allow-set-content-bounds",
    "allow-focus-content",
    "allow-settings-get",
    "allow-protection-set",
    "allow-theme-set",
    "allow-accent-set",
    "allow-welcome-done",
    "allow-about-get",
    "allow-notices-get",
    "allow-app-update-status",
    "allow-app-update-check",
    "allow-app-update-install",
    "allow-pages-theme-set",
    "allow-search-set",
    "allow-diagnostics-get",
    "allow-audit-clear",
    "allow-interstitial-action",
    "allow-notice-dismiss",
    "allow-prompt-respond",
    "allow-permission-reset",
    "allow-download-show",
    "allow-download-cancel",
    "allow-downloads-clear",
    "allow-site-filtering-set",
    "allow-filters-update-now",
    "allow-tab-new-temporary",
    "allow-cookie-sites",
    "allow-site-data-delete",
    "allow-data-inventory",
    "allow-data-clear",
    "allow-site-local-set",
    "allow-doh-custom-set",
    "allow-network-records-clear",
    "allow-selftest-start",
    "allow-selftest-last",
    "allow-audit-entries",
    "allow-audit-export",
    "allow-report-save",
    "allow-bookmarks-get",
    "allow-bookmark-add-tab",
    "allow-bookmark-edit",
    "allow-bookmark-remove",
    "allow-bookmark-folder-add",
    "allow-bookmark-move",
    "allow-bookmarks-import",
    "allow-bookmarks-export",
    "allow-bookmarks-delete-all"
  ]
}
